# Porta publicada no computador.
HTTP_PORT=8080

# Servidor HTTP dentro do container.
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=65536
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Administração local do MongoDB.
MONGO_ROOT_USERNAME=nexus_root
MONGO_ROOT_PASSWORD=CHANGE_ME

# Usuário com acesso somente ao banco da aplicação.
MONGO_APP_DATABASE=nexus
MONGO_APP_USERNAME=nexus_app
MONGO_APP_PASSWORD=CHANGE_ME

# Se a senha contiver caracteres reservados de URL, aplique percent-encoding.
MONGODB_URI=mongodb://nexus_app:CHANGE_ME@mongodb:27019/nexus?authSource=nexus
MONGODB_CONNECT_TIMEOUT=10s
MONGODB_OPERATION_TIMEOUT=5s

# JWT: use três segredos independentes.
JWT_ISSUER=nexus-api
JWT_AUDIENCE=nexus-web
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
REFRESH_TOKEN_PEPPER=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Cookies.
AUTH_ACCESS_COOKIE_NAME=nexus_access_token
AUTH_REFRESH_COOKIE_NAME=nexus_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax